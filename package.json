{
  "name": "siteproof-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SiteProof API — modular monolith for auth, jobs, rulebooks, extraction, compliance, and events",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed": "node --env-file=.env src/db/seed.js",
    "generate:sop": "node src/data/writeAcSopPdf.js",
    "smoke": "node --env-file=.env scripts/smoke.js",
    "test:cloudinary": "node --env-file=.env scripts/test-cloudinary.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  }
}
