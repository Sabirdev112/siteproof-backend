# Copy to .env for local, or set these in Railway Variables for deploy.
NODE_ENV=development
PORT=3000
MIGRATE_ON_START=true

# true = skip 002_pgvector.sql (Windows Postgres without the extension).
# Phase 4 needs pgvector: Docker image pgvector/pgvector:pg16, or Railway.
SKIP_PGVECTOR=true

# Local (Docker compose / pgAdmin):
#   postgres://siteproof:siteproof@localhost:5432/siteproof
# Railway: paste the plugin DATABASE_URL as-is (use the public URL from your machine,
# the private URL from a Railway-hosted API).
# DB in pgAdmin: host localhost, user postgres, database siteproof.
DATABASE_URL=postgres://postgres:REPLACE_WITH_PGADMIN_PASSWORD@localhost:5432/siteproof
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma-separated. Expo / Next.js origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Outbound n8n (job.closed). Local n8n vs hosted n8n.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/siteproof-job-closed
WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret

# Inbound n8n callbacks (PDF uploaded, action logged). Same value in n8n header X-Api-Key.
N8N_API_KEY=change-me-to-a-long-random-n8n-api-key

# local = ./uploads (HMAC file URLs). cloudinary = Cloudinary (set CLOUDINARY_*).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# PUBLIC_API_URL=http://localhost:3000
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=siteproof
# MEDIA_SIGN_TTL_SECONDS=900

# AI providers are wired in later phases. Leave empty until then.
# OPENAI_API_KEY=
LOG_LEVEL=info

# E2E seed accounts (npm run seed). One user per role.
SEED_ORG_NAME=KeepCodeIn Solar
SEED_OWNER_NAME=SiteProof Owner
SEED_OWNER_EMAIL=owner@siteproof.local
SEED_OWNER_PASSWORD=Owner123!
SEED_SUPERVISOR_NAME=SiteProof Supervisor
SEED_SUPERVISOR_EMAIL=supervisor@siteproof.local
SEED_SUPERVISOR_PASSWORD=Supervisor123!
SEED_WORKER_NAME=Ali Worker
SEED_WORKER_EMAIL=worker@siteproof.local
SEED_WORKER_PASSWORD=Worker123!
